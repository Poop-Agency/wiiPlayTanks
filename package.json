    "test": "bun test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  }
}
