{
  "name": "wii-play-tanks",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Clone de Tanks! (Wii Play) — simulation déterministe, rendu séparé, co-op en ligne",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
